# Copy to .env on the GCE VM and replace GCE_PUBLIC_IP placeholders.
# Never commit the resulting .env file.
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=5176
DATABASE_URL=sqlite:////data/tracecare.db
FRONTEND_ORIGIN=http://GCE_PUBLIC_IP:5176
VITE_API_BASE_URL=http://GCE_PUBLIC_IP:8001/api
SEED_ON_STARTUP=false

# App-only GCE deployment uses deterministic fallback.
LLM_MODE=disabled
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT_SECONDS=120

# GCE cannot access a USB ESP32 attached to the presenter laptop.
DEVICE_ADAPTER_MODE=simulated
DEVICE_SERIAL_PORT=
DEVICE_SERIAL_BAUD_RATE=115200
DEVICE_SERIAL_TIMEOUT_SECONDS=1.0
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=3.0

# Required for the competition reset/seed/run workflow. Restrict firewall
# source ranges because these development endpoints have no authentication.
DEMO_MANAGEMENT_ENABLED=true
